# ──────────────────────────────────────────────
# Caddy 설정 (nginx.conf.template 대체용)
# 정적 파일 서빙 + 기상청 API 프록시 역할을 수행한다.
#
# rewrite의 API_KEY_DATA_GO_KR 환경변수 자리표시자는 Caddy가 설정을 읽을 때 환경변수로 치환한다.
# ※ serviceKey는 공공데이터포털의 "Encoding" 인증키를 사용해야 한다(이미 URL 인코딩된 값).
# ──────────────────────────────────────────────
{
	# 로컬/컨테이너 실행용: 관리 API와 자동 HTTPS 비활성화
	admin off
	auto_https off
}

:80 {
	encode gzip

	# 기상청 API 프록시
	# /api/getUltraSrtNcst?... → https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getUltraSrtNcst?serviceKey=...&...
	handle_path /api/* {
		# 'uri query +serviceKey'는 값을 한 번 더 URL 인코딩하므로(Encoding 키가 깨짐)
		# rewrite로 쿼리스트링을 직접 조립한다.
		rewrite * /1360000/VilageFcstInfoService_2.0{path}?serviceKey={$API_KEY_DATA_GO_KR}&{query}

		# DNS는 요청 시점에 조회하므로 시작 시 네트워크가 없어도 컨테이너가 죽지 않는다.
		reverse_proxy {$KMA_UPSTREAM:https://apis.data.go.kr} {
			# Caddy는 기본적으로 클라이언트의 Host 헤더를 그대로 넘기므로 업스트림 호스트로 바꿔준다.
			header_up Host apis.data.go.kr
			header_up -Accept-Encoding
			transport http {
				dial_timeout 5s
				response_header_timeout 10s
			}
		}
	}

	# 정적 파일 서빙 (React 빌드 결과물) + SPA 라우팅 폴백
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# access log는 켜지 않는다 (인증키가 포함된 URL이 남지 않도록)
}
